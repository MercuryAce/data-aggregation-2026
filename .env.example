# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Never commit .env. URL-encode DB password special chars (/ → %2F, + → %2B).

SITE_URL=https://zixy.co.uk
SITEMAP_COIN_LIMIT=250
SITE_NAME=CryptoDash
SITE_DESCRIPTION=CryptoDash is a crypto dashboard that provides a comprehensive view of the crypto market.
SITE_ROBOTS=index, follow
SITEMAP_CACHE_SECONDS=3600
# Optional absolute URL; defaults to {SITE_URL}/static/img/logo.png
# SEO_DEFAULT_IMAGE=https://zixy.co.uk/static/img/logo.png

# ---------------------------------------------------------------------------
# Flask / app
# ---------------------------------------------------------------------------
FLASK_DEBUG=true
FLASK_ENV=debug
# Production: FLASK_DEBUG=false and FLASK_ENV=production (SECRET_KEY required)
# Required when FLASK_ENV=production
SECRET_KEY=
# Used when SECRET_KEY is unset in non-production
DEV_SECRET_KEY=change-me-dev-only

CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=60
# Production (multi-worker): prefer Redis shared store, e.g.
# CACHE_TYPE=RedisCache
# RATELIMIT_STORAGE_URI=redis://localhost:6379/2

RATELIMIT_DAILY=2000 per day
RATELIMIT_HOURLY=300 per hour
RATELIMIT_STORAGE_URI=memory://

# Session click-spam cooldown (seconds). 0 = disabled.
REQUEST_GUARD_COOLDOWN=0
# CG / ApiCache routes (coin detail, search, OHLC)
PAGE_RATE_LIMIT=60 per minute
# MySQL list pages (Market / Exchanges / Trending / Categories)
VIEWS_RATE_LIMIT=120 per minute

# Celery (optional / legacy — production uses crontab; see deploy/crontab.example)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MySQL (preferred). Omit to fall back to instance/cache.db SQLite.
DATABASE_URI=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/cryptodash

# ---------------------------------------------------------------------------
# CoinGecko (required for view populate + coin/search sync)
# Demo key header: x-cg-demo-api-key | Pro: x-cg-pro-api-key
# ---------------------------------------------------------------------------
CG_API_KEY=
CG_API_KEY_HEADER=x-cg-demo-api-key
CG_BASE_URL=https://api.coingecko.com/api/v3
CG_REQUEST_TIMEOUT=15

# ---------------------------------------------------------------------------
# CoinMarketCap (Markets live metrics patch)
# ---------------------------------------------------------------------------
CMC_API_KEY=
CMC_API_KEY_HEADER=X-CMC_PRO_API_KEY
CMC_BASE_URL=https://pro-api.coinmarketcap.com/v1
CMC_REQUEST_TIMEOUT=15

# ---------------------------------------------------------------------------
# Messari (optional / future writers)
# ---------------------------------------------------------------------------
MESSARI_API_KEY=
MESSARI_API_KEY_HEADER=x-messari-api-key
MESSARI_BASE_URL=https://api.messari.io
MESSARI_REQUEST_TIMEOUT=15

# ---------------------------------------------------------------------------
# DefiLlama (optional; public endpoints work without a key)
# ---------------------------------------------------------------------------
DEFILLAMA_API_KEY=
DEFILLAMA_API_KEY_HEADER=
DEFILLAMA_BASE_URL=https://api.llama.fi
DEFILLAMA_REQUEST_TIMEOUT=30

# ---------------------------------------------------------------------------
# Alpha Vantage (optional)
# ---------------------------------------------------------------------------
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_BASE_URL=https://www.alphavantage.co/query
ALPHAVANTAGE_REQUEST_TIMEOUT=15

# ---------------------------------------------------------------------------
# Spot venues (prototype bid/ask). Public tickers work without keys;
# keys are for future signed endpoints. Binance.US: api.binance.us
# ---------------------------------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET_KEY=
BINANCE_API_KEY_HEADER=X-MBX-APIKEY
BINANCE_BASE_URL=https://api.binance.us
BINANCE_REQUEST_TIMEOUT=15

KRAKEN_API_KEY=
KRAKEN_API_SECRET_KEY=
KRAKEN_API_KEY_HEADER=API-Key
KRAKEN_BASE_URL=https://api.kraken.com
KRAKEN_REQUEST_TIMEOUT=15

OKX_API_KEY=
OKX_API_SECRET_KEY=
OKX_API_PASSPHRASE=
OKX_BASE_URL=https://www.okx.com
OKX_REQUEST_TIMEOUT=15

# ---------------------------------------------------------------------------
# Financial Modeling Prep (optional)
# ---------------------------------------------------------------------------
FPM_API_KEY=
FPM_BASE_URL=https://financialmodelingprep.com/stable/
FPM_REQUEST_TIMEOUT=15

# ---------------------------------------------------------------------------
# MongoDB Atlas time-series ticks (optional)
# ---------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=cryptodash
MONGODB_TLS_CERT_FILE=certificates/your-x509-cert.pem


ANALYTICS_API_URL=http://<ANALYTICS_LAN_IP>:<analytics_port>
ANALYTICS_API_KEY=
